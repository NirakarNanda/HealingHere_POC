# Bijayalakshmi Physiotherapy — Backend environment
# Copy to .env and fill in. Never commit a real .env.

PORT=5000
NODE_ENV=development

# Local MongoDB (run `mongod --dbpath <path>` or the MongoDB service on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/bijayalakshmi_physiotherapy

# Doctor login credentials (POC defaults — CHANGE before any production use)
ADMIN_USERNAME=DRAbhilash
ADMIN_PASSWORD=Ved@123

# Session secret — must be a long random string.
# The server refuses to start in production with the placeholder below.
SESSION_SECRET=change-me-to-a-long-random-string

# Google Apps Script web-app URL (leave empty to skip the Sheets step in dev)
APPS_SCRIPT_URL=

# Frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:3000
